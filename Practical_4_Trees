#include<iostream>
#include<string.h>
using namespace std;

struct Node
{
	char label[10];
	int count;
	struct Node *child[10];
} *root;

class Tree
{
	public:
		Tree()
		{
			root = NULL;
		}
		
		void create()
		{
			root = new Node;
			
			cout<<"Enter subject name:";
			cin>>root->label;
			cout<<"Enter total number of chapters:";
			cin>>root->count;
			
			for(int i = 0; i < root->count; i++)
			{
				root->child[i] = new Node;
				
				cout<<"In "<<root->label<<", enter chapter name:";
				cin>>root->child[i]->label;
				cout<<"Enter total number of sections in "<<root->child[i]->label<<":";
				cin>>root->child[i]->count;
				
				for(int j = 0; j < root->child[i]->count; j++)
				{
					root->child[i]->child[j] = new Node;
					
					cout<<"In "<<root->child[i]->label<<", enter section name:"; 
					cin>>root->child[i]->child[j]->label;
					cout<<"Enter total number of sub-topics in "<<root->child[i]->child[j]->label<<":";
					cin>>root->child[i]->child[j]->count;
					
					for(int k = 0; k < root->child[i]->child[j]->count; k++)
					{
						root->child[i]->child[j]->child[k] = new Node;
						
						cout<<"In "<<root->child[i]->child[j]->label<<", enter sub-section name:";
						cin>>root->child[i]->child[j]->child[k]->label;
					}
				}
			}
		}
		
		void display(Node *dis)
		{
			if(dis != NULL)
			{
				cout<<"\n!===BOOK HIERARCHY===!"<<endl;
				cout<<"\n";
				cout<<"Subject Name: "<<dis->label<<endl;
				
				for(int i = 0; i < dis->count; i++)
				{
					cout<<"\n";
					cout<<"Chapter "<<i + 1<<": "<<dis->child[i]->label<<endl;
					
					for(int j = 0; j < dis->child[i]->count; j++)
					{
						cout<<"Section "<<j + 1<<": "<<dis->child[i]->child[j]->label<<endl;
						
						for(int k = 0; k < dis->child[i]->child[j]->count; k++)
						{
							cout<<"Sub-topic "<<k + 1<<": "<<dis->child[i]->child[j]->child[k]->label<<endl;
						}
					}
				}
			}
		}
};

int main()
{
	Tree t;
	int ch;
	
	while(1)
	{
		cout<<"\n";
		cout<<"!======MENU======!"<<endl;
		cout<<"1. Create a Tree"<<endl;
		cout<<"2. Display a Tree"<<endl;
		cout<<"3. EXIT"<<endl;
		
		cout<<"\n";
		cout<<"Enter your choice:";
		cin>>ch;
		
		if(ch == 1)
		{
			t.create();
		}
		else if(ch == 2)
		{
			t.display(root);
		}
		else if(ch == 3)
		{
			cout<<"Thank You!!"<<endl;
			break;
		}
		else
		{
			cout<<"Invalid!!"<<endl;
		}
	}
	
	return 0;
}
